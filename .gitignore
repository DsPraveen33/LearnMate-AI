# ==============================================================================
# LearnMate AI — Git Exclusion Rules (.gitignore)
# AICTE–IBM SkillsBuild Internship 2026
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables, Secrets & API Keys (CRITICAL - NEVER COMMIT)
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
*.pem
*.key
*.pfx
*.p12
credentials.*
secrets.*
id_rsa*
id_ed25519*

# ------------------------------------------------------------------------------
# 2. Local Databases & SQLite Storage (DO NOT OVERWRITE OR LEAK)
# ------------------------------------------------------------------------------
learnmate.db
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3

# ------------------------------------------------------------------------------
# 3. Python Virtual Environments & Packages
# ------------------------------------------------------------------------------
.venv/
venv/
ENV/
env/
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# 4. Node.js & Frontend Dependencies
# ------------------------------------------------------------------------------
node_modules/
.npm/
.yarn/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 5. Build Artifacts & Frontend Output
# ------------------------------------------------------------------------------
frontend/dist/
frontend/dist-ssr/
dist/
dist-ssr/
out/
.vite/
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 6. Python Cache, Bytecode & Testing Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
coverage/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# ------------------------------------------------------------------------------
# 7. Operating System & IDE Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ------------------------------------------------------------------------------
# 8. Temporary Logs, Archives & Bundles
# ------------------------------------------------------------------------------
*.log
logs/
*.zip
*.tar.gz
*.rar
*.7z

